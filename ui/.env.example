# Tất cả đều tùy chọn. Bỏ trống để dùng giá trị mặc định.

# Thư mục chứa latest.json (mặc định: %LOCALAPPDATA%\libpack trên Windows,
# ~/Library/Application Support/libpack trên macOS, ~/.local/share/libpack trên Linux)
LIBPACK_DATA_DIR=

# Đường dẫn tới file chạy pkgscan (mặc định: ../agent/dist/pkgscan-<os>-<arch>[.exe])
LIBPACK_AGENT_PATH=

# Registry dùng để kiểm tra phiên bản mới (mặc định: https://registry.npmjs.org)
NPM_REGISTRY_URL=
